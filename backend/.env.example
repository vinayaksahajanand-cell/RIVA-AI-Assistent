# ─────────────────────────────────────────────────────────────────────────────
# RIVA AI backend configuration. Copy to `backend/.env` and fill in the values.
# Never commit real secrets. Every value below is a placeholder or a safe default.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development            # development | production
LOG_LEVEL=INFO
LOG_JSON=false                     # true in production for structured logs
API_PORT=8100
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Security (REQUIRED in production) ────────────────────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
COOKIE_SECURE=false                # true when served over HTTPS
ALLOW_REGISTRATION=true            # false = only admins create accounts (python -m app.cli create-user)
# shared   = one organization: first sign-up becomes admin, later sign-ups join as "user" (admin can promote)
# personal = every sign-up gets a private workspace where they are admin
REGISTRATION_MODE=shared

# ── Database & cache ─────────────────────────────────────────────────────────
# Docker Compose publishes PostgreSQL (with pgvector) on port 5434 by default.
DATABASE_URL=postgresql+asyncpg://riva:riva_dev_password@localhost:5434/riva
REDIS_URL=redis://localhost:6379/0  # optional; leave empty for in-process cache/rate limiting

# ── OpenAI (required for answers and RAGAS/DeepEval scoring) ─────────────────
OPENAI_API_KEY=
# OPENAI_BASE_URL=                 # optional OpenAI-compatible endpoint (vLLM, Ollama /v1, proxies)
LLM_MODEL=gpt-4.1-mini             # default answer model
FAST_LLM_MODEL=gpt-4.1-mini        # query analysis, relevance grading, verification
AVAILABLE_MODELS=gpt-4.1-mini,gpt-4.1,gpt-4o-mini,gpt-5-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1200
# Optional cost estimation, USD per 1M tokens. Verify against current OpenAI pricing before enabling.
# MODEL_PRICING_JSON={"gpt-4.1-mini": {"input": 0.40, "output": 1.60}}

# ── Embeddings ───────────────────────────────────────────────────────────────
# openai    → text-embedding-3-small (1536) or text-embedding-3-large (3072, or reduced via dimensions)
# fastembed → fully local ONNX models, no API key, e.g. BAAI/bge-small-en-v1.5 (384)
# Changing provider/model/dimensions later requires: python -m app.cli reset-embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64

# ── Chunking defaults (each workspace can override in Settings) ──────────────
CHUNK_STRATEGY=structure           # recursive | token | semantic | structure | parent_child
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
PARENT_CHUNK_SIZE_TOKENS=2000
CHILD_CHUNK_SIZE_TOKENS=400

# ── Retrieval defaults ───────────────────────────────────────────────────────
RETRIEVAL_TOP_K=10
FINAL_CONTEXT_K=5
RRF_K=60
DENSE_WEIGHT=1.0
SPARSE_WEIGHT=1.0
BM25_K1=1.2
BM25_B=0.75
RERANKER_ENABLED=true
RERANKER_PROVIDER=cross-encoder    # cross-encoder | none
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
MAX_CORRECTIVE_ATTEMPTS=1
GROUNDED_ONLY_DEFAULT=true
CONVERSATION_MEMORY_TURNS=6

# ── Uploads & OCR ────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=50
MAX_FILES_PER_UPLOAD=20
STORAGE_DIR=./storage
OCR_ENABLED=true                   # RapidOCR for scanned PDF pages (no system install needed)

# ── Background worker ────────────────────────────────────────────────────────
EMBEDDED_WORKER=true               # false when running `python -m app.worker` separately
JOB_MAX_ATTEMPTS=3

# ── Evaluation ───────────────────────────────────────────────────────────────
ONLINE_EVALUATION_ENABLED=true     # RAGAS after every answer (asynchronous, needs OPENAI_API_KEY)
EVALUATION_LLM_MODEL=gpt-4.1-mini
EVALUATION_EMBEDDING_MODEL=text-embedding-3-small
EVALUATION_TIMEOUT_SECONDS=180
DEEPEVAL_THRESHOLD=0.7

# ── LangSmith observability (optional) ───────────────────────────────────────
LANGCHAIN_TRACING_V2=false         # LANGSMITH_TRACING is also accepted
LANGCHAIN_API_KEY=                 # LANGSMITH_API_KEY is also accepted
LANGCHAIN_PROJECT=RIVA-AI
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com   # EU: https://eu.api.smith.langchain.com
TRACE_DOCUMENT_CONTENT=false       # false = document text is redacted before leaving the server
TRACE_QA_CONTENT=true              # false = also hide questions/answers (only spans, timings, metadata)

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=20
RATE_LIMIT_AUTH_PER_MINUTE=10
