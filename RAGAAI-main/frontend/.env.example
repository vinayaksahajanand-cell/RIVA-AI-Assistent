# RIVA AI frontend configuration (copy to .env.local for local development).
#
# Base URL of the RIVA AI FastAPI backend, as reachable from the browser.
# Inlined into the client bundle at build time (Docker: pass as --build-arg).
# The backend must allow this frontend origin in CORS_ORIGINS with credentials,
# because the session is an httpOnly cookie sent with credentials: "include".
NEXT_PUBLIC_API_URL=http://localhost:8100
